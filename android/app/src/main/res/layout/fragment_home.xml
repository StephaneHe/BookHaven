<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Grande carte « Reprendre » (masquée s'il n'y a rien à reprendre) -->
        <LinearLayout
            android:id="@+id/cardResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/colorPrimary"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivResumeCover"
                android:layout_width="90dp"
                android:layout_height="130dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_book_placeholder"
                android:contentDescription="@string/home_resume" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_resume"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvResumeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvResumeAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbResume"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/resume_reading" />

            </LinearLayout>

        </LinearLayout>

        <!-- Rail « En cours » -->
        <TextView
            android:id="@+id/tvInProgressLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_in_progress"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Rail « Récemment ajoutés » -->
        <TextView
            android:id="@+id/tvRecentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_recent"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Raccourcis Catégories -->
        <TextView
            android:id="@+id/tvCategoriesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_categories"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />

        </HorizontalScrollView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
