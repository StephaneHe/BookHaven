# Data & cache (generated at runtime, at the repo root only).
# Anchored with a leading slash: an unanchored "data/" also matched the Android
# source package android/.../data/, silently keeping its whole data layer
# (api, repository, db) out of git.
/data/
/cache/
*.db

# Python virtual env
.venv/
venv/

# Backups (rotation dumps, pre-change snapshots)
backup/

# Build artifacts
*.apk

# Python
__pycache__/
*.pyc
*.pyo

# Logs (watchdog output, migration mapping files)
*.log
*.log.*
logs/

# Environment / secrets
# .env.bak* catches rotation backups, which still hold the previous secrets.
# .env.example stays tracked on purpose.
.env
.env.bak*
server.crt
server.key

# IDE
.vscode/
.idea/

# Claude Code
.claude/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Temp files
*.pid
