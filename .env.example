# BookHaven environment variables
# Copy this file to .env and fill in your values (.env is gitignored).

BOOKHAVEN_PORT=8097

# REQUIRED. Minimum 32 characters — config.py raises RuntimeError at startup
# if this is missing, too short, or left at the old "bookhaven-dev-secret".
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BOOKHAVEN_SECRET_KEY=

# Library root. Must be a native Windows path (e.g. H:\Books).
# A WSL-style path such as /mnt/h/Books makes uploads land in a phantom
# directory, because writes do not go through _resolve_book_path().
BOOKS_ROOT=H:\Books

# Vestigial: auth is local (users table), not Jellyfin. Kept for reference.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your-jellyfin-api-key-here
